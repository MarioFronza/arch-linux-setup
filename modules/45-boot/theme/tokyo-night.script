Window.SetBackgroundTopColor(0.102, 0.106, 0.149);
Window.SetBackgroundBottomColor(0.102, 0.106, 0.149);

entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = Window.GetHeight() / 2 - entry.image.GetHeight() / 2;
entry.sprite.SetPosition(entry.x, entry.y, 1);
entry.sprite.SetOpacity(0);

bullet.image = Image("bullet.png");
bullet.sprites = [];
bullet.gap = 6;
bullet.max = Math.Int((entry.image.GetWidth() - 32) / (bullet.image.GetWidth() + bullet.gap));

box.image = Image("progress_box.png");
box.sprite = Sprite(box.image);
box.x = Window.GetWidth() / 2 - box.image.GetWidth() / 2;
box.y = Window.GetHeight() / 2 - box.image.GetHeight() / 2;
box.sprite.SetPosition(box.x, box.y, 1);
box.sprite.SetOpacity(0);

bar.image = Image("progress_bar.png");
bar.sprite = Sprite(bar.image);
bar.sprite.SetPosition(box.x, box.y, 2);
bar.sprite.SetOpacity(0);
bar.travel = box.image.GetWidth() - bar.image.GetWidth();

loading.asked = 0;
loading.shown = 0;
loading.frame = 0;

fun refresh_callback() {
  if (!loading.shown)
    return;
  loading.frame++;
  position = (1 - Math.Cos(loading.frame / 50 * Math.Pi)) / 2;
  bar.sprite.SetX(box.x + Math.Int(bar.travel * position));
}

fun hide_bullets() {
  for (i = 0; bullet.sprites[i]; i++)
    bullet.sprites[i].SetOpacity(0);
}

fun display_password_callback(prompt, bullets) {
  loading.asked = 1;
  box.sprite.SetOpacity(0);
  bar.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(1);
  hide_bullets();

  count = bullets;
  if (count > bullet.max)
    count = bullet.max;

  for (i = 0; i < count; i++) {
    if (!bullet.sprites[i]) {
      bullet.sprites[i] = Sprite(bullet.image);
      bullet.sprites[i].SetPosition(
        entry.x + 16 + i * (bullet.image.GetWidth() + bullet.gap),
        entry.y + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2,
        2);
    }
    bullet.sprites[i].SetOpacity(1);
  }
}

fun display_normal_callback() {
  entry.sprite.SetOpacity(0);
  hide_bullets();
  if (loading.asked && !loading.shown) {
    loading.shown = 1;
    box.sprite.SetOpacity(1);
    bar.sprite.SetOpacity(1);
  }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetRefreshFunction(refresh_callback);
